# Quarto
/.quarto/
_freeze/
docs/
**/*.quarto_ipynb
*.html
*.pdf
*_files/
*_cache/

# R
.Rhistory
.RData
.Rproj.user/

# renv cache (the lockfile is tracked, not the library)
renv/library/
renv/staging/

# Output files (regenerated by rendering analysis.qmd)
outputs/**
!outputs/**/
!outputs/**/.gitkeep

# Generated by scripts/generate_evidence.R — regenerate after each render,
# don't hand-edit or commit a stale copy
evidence.json

# Large raw data files — upload these directly to Zenodo instead
# (the small example_data.csv shipped with this template is tracked
# on purpose so the project renders out of the box)
data/raw/*.xlsx
data/raw/*.zip

# OS
.DS_Store
Thumbs.db

# Large files
*.zip
*.tar.gz
